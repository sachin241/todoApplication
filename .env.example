SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_ENGINE=sqlite
# Neon/Render production: set DATABASE_ENGINE=postgresql and the full Neon URL.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set DATABASE_ENGINE=postgresql and fill the values below when PostgreSQL is ready.
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=your-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432
